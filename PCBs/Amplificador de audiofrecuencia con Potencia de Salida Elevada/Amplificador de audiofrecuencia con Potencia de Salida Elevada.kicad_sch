	(text "K1 L1 L2 L3 0.97\n"
		(exclude_from_sim no)
		(at 82.55 84.328 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2f9a27ca-ece5-4e1b-8b51-d1f1acb5ba1a")
	)
	(text "\n.options method=trap reltol=5e-3 abstol=1n vntol=1m cshunt=10f\n.control\n  * 0. Environment Setup\n  reset\n  setplot new\n  \n  * 1. AC Analysis (Bode Plot)\n  alter vb1 acmag=1\n  ac dec 40 10 100k\n  set ac_res = $curplot\n  echo \"==================================================\"\n  echo \"            AC ANALYSIS (STABILITY CHECK)         \"\n  echo \"==================================================\"\n  let mid_gain_db = db(v(OUT)[80])\n  echo \"Mid-band Gain (dB):\"\n  print mid_gain_db\n\n  * 2. Transient Analysis (Oscillation Check)\n  alter vb1 acmag=0\n  tran 20u 200m\n  set tran_res = $curplot\n  echo \"\"\n  echo \"==================================================\"\n  echo \"           TRANSIENT PERFORMANCE (9V)             \"\n  echo \"==================================================\"\n  meas tran v_out_pp PP V(OUT) FROM=150m TO=200m\n  * Measure period of the \"fuzz\" to find oscillation frequency\n  meas tran t_ring TRIG V(OUT) VAL=0 RISE=100 TARG V(OUT) VAL=0 RISE=101\n  let f_ring = 1/t_ring\n  echo \"Parasitic Ringing Frequency (Hz):\"\n  print f_ring\n\n  * 3. Fourier Analysis\n  echo \"\"\n  echo \"==================================================\"\n  echo \"          DISTORTION ANALYSIS (THD)               \"\n  echo \"==================================================\"\n  fourier 1k V(OUT)\n  \n  * Optional: view plots\n  * setplot $ac_res\n  * plot db(v(OUT))\n  * setplot $tran_res\n  * plot v(OUT)\n.endc"
		(exclude_from_sim no)
		(at 57.912 138.684 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3e44cfaa-8d9f-444a-8906-380e4eb42494")
	)
	(text ".tran 20u 200m uic"
		(exclude_from_sim no)
		(at 26.416 84.074 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "78231496-81ee-406f-a813-ec15ce568439")
	)
